# Client-side (safe to expose — designed to be public)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-project-token
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-public-key
# Sentry DSN is not sensitive — it's embedded in the bundle (EXPO_PUBLIC_ is correct)
# Find it at: sentry.io > valecrest org > your project > Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.eu.sentry.io/XXXXXXX

# Sentry auth token — used only during EAS Build for sourcemap upload (never in the bundle)
# TODO: Add via `eas secret:create --name SENTRY_AUTH_TOKEN --value <token>` when setting up EAS Build
# Generate at: sentry.io > Settings > Auth Tokens
# SENTRY_AUTH_TOKEN=sntrys_...

# Server-side only — set in Supabase Dashboard > Settings > Edge Functions > Secrets
# ANTHROPIC_KEY=sk-ant-...
# OPENAI_KEY=sk-proj-...
# ELEVENLABS_KEY=...
# ELEVENLABS_VOICE_ID=...
