# Client-side (safe to expose — designed to be public)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-project-token
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-public-key

# Server-side only — set in Supabase Dashboard > Settings > Edge Functions > Secrets
# ANTHROPIC_KEY=sk-ant-...
# OPENAI_KEY=sk-proj-...
# ELEVENLABS_KEY=...
# ELEVENLABS_VOICE_ID=...
